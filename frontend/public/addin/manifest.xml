<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="TaskPaneApp">

  <Id>a1b2c3d4-e5f6-7890-abcd-ef1234567890</Id>
  <Version>1.0.0</Version>
  <ProviderName>Auto Speaker Notes</ProviderName>
  <DefaultLocale>ja-JP</DefaultLocale>
  <DisplayName DefaultValue="Auto Speaker Notes" />
  <Description DefaultValue="リハーサル中の発話を自動でスピーカーノートに変換するアドインです" />

  <IconUrl DefaultValue="https://YOUR_VERCEL_URL/addin/assets/icon-32.svg" />
  <HighResolutionIconUrl DefaultValue="https://YOUR_VERCEL_URL/addin/assets/icon-80.svg" />
  <SupportUrl DefaultValue="https://github.com/" />

  <Hosts>
    <Host Name="Presentation" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://YOUR_VERCEL_URL/addin/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Presentation">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="getStartedTitle" />
            <Description resid="getStartedDesc" />
            <LearnMoreUrl resid="learnMoreUrl" />
          </GetStarted>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="autoSpeakerNotesGroup">
                <Label resid="groupLabel" />
                <Icon>
                  <bt:Image size="16" resid="icon16" />
                  <bt:Image size="32" resid="icon32" />
                  <bt:Image size="80" resid="icon80" />
                </Icon>
                <Control xsi:type="Button" id="showTaskpane">
                  <Label resid="btnLabel" />
                  <Supertip>
                    <Title resid="btnLabel" />
                    <Description resid="btnDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>AutoSpeakerNotesPane</TaskpaneId>
                    <SourceLocation resid="taskpaneUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://YOUR_VERCEL_URL/addin/assets/icon-16.svg" />
        <bt:Image id="icon32" DefaultValue="https://YOUR_VERCEL_URL/addin/assets/icon-32.svg" />
        <bt:Image id="icon80" DefaultValue="https://YOUR_VERCEL_URL/addin/assets/icon-80.svg" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="taskpaneUrl" DefaultValue="https://YOUR_VERCEL_URL/addin/taskpane.html" />
        <bt:Url id="learnMoreUrl" DefaultValue="https://github.com/" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="getStartedTitle" DefaultValue="Auto Speaker Notes" />
        <bt:String id="groupLabel" DefaultValue="Speaker Notes" />
        <bt:String id="btnLabel" DefaultValue="Auto Notes" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="getStartedDesc" DefaultValue="リハーサルの発話からスピーカーノートを自動生成します" />
        <bt:String id="btnDesc" DefaultValue="リハーサル中の発話を録音し、スピーカーノートとして書き込みます" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
